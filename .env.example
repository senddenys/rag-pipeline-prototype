# Copy to .env and fill in your values

# Free LLM (no card): get key at https://console.groq.com — used first if set
GROQ_API_KEY=gsk_...

# Optional: OpenAI for LLM synthesis (billing required)
OPENAI_API_KEY=sk-...

# Optional: local Ollama (install from ollama.ai, then: ollama run llama3.2)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional: override embedding model (default: local sentence-transformers)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB is local; no API key needed
# CHROMA_PERSIST_DIR=./chroma_data
